# Copy to .env for local runs. On Render, set these under Environment instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
API_KEY=choose-a-long-random-key
ADMIN_PASSWORD=choose-a-staff-password
# From Zendesk Admin Center > Channels > Messaging > your widget > Installation (the part after key=)
ZENDESK_WIDGET_KEY=
